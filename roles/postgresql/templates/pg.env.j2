# {{ ansible_managed }}
# Sourced by every pg-ops script (backup wrapper, VIP guard, event hook).
PG_VERSION={{ pg_version | string | quote }}
PG_BIN={{ pg_bin_dir | quote }}
PGDATA={{ pg_data_dir | quote }}
PG_PORT={{ pg_port | string | quote }}
PG_SERVICE={{ pg_service | quote }}
PG_CLUSTER_NAME={{ pg_cluster_name | quote }}
PG_NODE_NAME={{ repmgr_node_name | quote }}
PG_NODE_IP={{ pg_node_ip | quote }}
PG_PEERS={{ groups['pg_data'] | difference([inventory_hostname]) | map('extract', hostvars, 'pg_node_ip') | join(' ') | quote }}
REPMGR_USER={{ repmgr_user | quote }}
REPMGR_DB={{ repmgr_db | quote }}
REPMGR_CONF={{ repmgr_conf_path | quote }}
REPMGR_SERVICE={{ repmgr_service | quote }}
PGPASSFILE={{ (pg_home_dir ~ '/.pgpass') | quote }}
PGOPS_LOG_DIR={{ pgops_log_dir | quote }}
PGOPS_MAINTENANCE_FLAG={{ pgops_maintenance_flag | quote }}
export PGDATA PGPASSFILE
