# {{ ansible_managed }}
# PostgreSQL {{ pg_version }} compiled by pg-ops ({{ pg_install_link }} -> current minor)
[Unit]
Description=PostgreSQL {{ pg_version }} database server (pg-ops)
Documentation=https://www.postgresql.org/docs/{{ pg_version }}/static/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=postgres
Group=postgres
Environment=PGDATA={{ pg_data_dir }}/
OOMScoreAdjust=-1000
Environment=PG_OOM_ADJUST_FILE=/proc/self/oom_score_adj
Environment=PG_OOM_ADJUST_VALUE=0
ExecStart={{ pg_bin_dir }}/postgres -D ${PGDATA}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutSec=0
TimeoutStartSec=0
TimeoutStopSec=1h

[Install]
WantedBy=multi-user.target
