# {{ ansible_managed }}
[Unit]
Description=repmgrd for PostgreSQL {{ pg_version }} (pg-ops)
After={{ pg_service }}.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart={{ pg_bin_dir }}/repmgrd -f {{ repmgr_conf_path }} --daemonize=false
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
