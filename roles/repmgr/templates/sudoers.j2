# {{ ansible_managed }}
Cmnd_Alias PGOPS_SVC = /usr/bin/systemctl start {{ pg_service }}, \
                       /usr/bin/systemctl stop {{ pg_service }}, \
                       /usr/bin/systemctl restart {{ pg_service }}, \
                       /usr/bin/systemctl reload {{ pg_service }}, \
                       /usr/bin/systemctl start {{ repmgr_service }}, \
                       /usr/bin/systemctl stop {{ repmgr_service }}
Defaults:postgres !requiretty
postgres ALL=(root) NOPASSWD: PGOPS_SVC
